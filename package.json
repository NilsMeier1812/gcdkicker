{
  "name": "gcdkicker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply kicker-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kicker-db --remote",
    "db:import:local": "wrangler d1 execute kicker-db --local --file=./data.sql",
    "db:import:remote": "wrangler d1 execute kicker-db --remote --file=./data.sql"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.2"
  }
}
